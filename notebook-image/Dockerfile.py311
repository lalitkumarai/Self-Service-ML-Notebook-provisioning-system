# =============================================================================
# ML Notebook — Python 3.11 Image  (ml-notebook:py311)
# =============================================================================
FROM jupyter/base-notebook:python-3.11

LABEL version="py311"
LABEL python="3.11"

USER root
RUN apt-get update && apt-get install -y --no-install-recommends curl git \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

USER ${NB_UID}
COPY requirements.txt /tmp/requirements.txt

RUN pip install --no-cache-dir -r /tmp/requirements.txt \
    && pip install --no-cache-dir ipywidgets \
    && python -c "import numpy, pandas, sklearn, matplotlib, seaborn; print('✅ py311 verified')"

# ── Auto-import startup + starter notebook ────────────────────────────────────
COPY 00_imports.py /home/jovyan/.ipython/profile_default/startup/00_imports.py
COPY startup.ipynb /home/jovyan/work/00_Getting_Started.ipynb
USER root
RUN chown -R ${NB_UID}:${NB_GID} /home/jovyan/.ipython \
    && chown ${NB_UID}:${NB_GID} /home/jovyan/work/00_Getting_Started.ipynb
USER ${NB_UID}

WORKDIR /home/jovyan/work
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -f http://localhost:8888/api || exit 1
EXPOSE 8888
CMD ["start-notebook.sh", "--NotebookApp.allow_origin=*", "--NotebookApp.disable_check_xsrf=True"]
